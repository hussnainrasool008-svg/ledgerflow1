rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidInstallationId(userId) {
      return userId is string && userId.size() >= 4 && userId.size() <= 128;
    }

    // Anonymous Installation User Documents & Subcollections
    match /users/{userId} {
      allow read, write: if isValidInstallationId(userId);

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow read, write: if isValidInstallationId(userId);

        // Records Subcollection (Task Spreadsheet Rows)
        match /records/{recordId} {
          allow read, write: if isValidInstallationId(userId);
        }
      }

      // Notes Subcollection (Notepad)
      match /notes/{noteId} {
        allow read, write: if isValidInstallationId(userId);
      }
    }
  }
}

